{
  "schema_version": 1,
  "id": "bakeoff/plotly/order-lines",
  "title": "Order amount per day (Plotly)",
  "description": "200,000 synthetic order lines aggregated per day in the browser with DuckDB. Filter with the Days and Region controls.",
  "tags": [
    "bakeoff",
    "sample"
  ],
  "author": "sample@example.com",
  "created_at": "2026-09-22T10:00:00Z",
  "updated_at": "2026-09-22T10:00:00Z",
  "renderer": "plotly",
  "spec": {
    "traces": [
      {
        "type": "bar",
        "x": {
          "column": "day"
        },
        "y": {
          "column": "amount"
        }
      }
    ],
    "layout": {
      "xaxis": {
        "title": {
          "text": "Day"
        }
      },
      "yaxis": {
        "title": {
          "text": "Amount"
        }
      }
    }
  },
  "data": {
    "format": "parquet",
    "lane": "large",
    "rows": 200000,
    "bytes": 558311,
    "columns": [
      {
        "name": "day",
        "type": "date"
      },
      {
        "name": "region",
        "type": "string"
      },
      {
        "name": "product",
        "type": "string"
      },
      {
        "name": "amount",
        "type": "number"
      }
    ]
  },
  "aggregate": "SELECT day, sum(amount) AS amount FROM data GROUP BY day ORDER BY day"
}
