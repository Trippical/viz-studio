{
  "schema_version": 1,
  "id": "bakeoff/plotly/time-series",
  "title": "Revenue by region, monthly (Plotly)",
  "description": "Monthly revenue per region. Filter with the Period and Region controls.",
  "tags": [
    "bakeoff",
    "sample"
  ],
  "author": "sample@example.com",
  "created_at": "2026-09-22T10:00:00Z",
  "updated_at": "2026-09-22T10:00:00Z",
  "renderer": "plotly",
  "spec": {
    "traces": [
      {
        "type": "scatter",
        "mode": "lines+markers",
        "split": "region",
        "x": {
          "column": "month"
        },
        "y": {
          "column": "revenue"
        }
      }
    ],
    "layout": {
      "xaxis": {
        "title": {
          "text": "Month"
        }
      },
      "yaxis": {
        "title": {
          "text": "Revenue"
        }
      },
      "legend": {
        "title": {
          "text": "Region"
        }
      },
      "hovermode": "x unified"
    }
  },
  "data": {
    "format": "json",
    "lane": "small",
    "rows": 144,
    "bytes": 14756,
    "columns": [
      {
        "name": "month",
        "type": "date"
      },
      {
        "name": "region",
        "type": "string"
      },
      {
        "name": "revenue",
        "type": "number"
      },
      {
        "name": "orders",
        "type": "integer"
      }
    ]
  },
  "aggregate": null
}
